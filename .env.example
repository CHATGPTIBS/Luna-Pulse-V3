# Luna Terminal web access. Use a long random value and do not commit the real key.
WEB_ADMIN_TOKEN=
PORT=10000

# Required Solana data/execution providers.
HELIUS_API_KEY=
JUPITER_API_KEY=

# Legacy Discord runtime (optional; only needed for npm run start:discord).
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
ADMIN_USER_ID=

# RPC fallback and realtime wallet accelerator.
SOLANA_SIGNATURE_RPC_URL=https://api.mainnet-beta.solana.com
# Optional explicit WebSocket URL. If blank, V5 uses Helius mainnet WSS with HELIUS_API_KEY.
SOLANA_WS_URL=
REALTIME_WALLET_STREAM=true

# V5 wallet monitoring. WebSocket notifications wake leaders immediately; polling remains fallback.
WALLET_SCHEDULER_MS=1000
WALLET_HOT_POLL_MS=15000
WALLET_HOT_HOLD_MS=300000
WALLET_IDLE_POLL_MS=60000
PRICE_POLL_MS=30000
HELIUS_TX_LIMIT=20

# Helius protection
HELIUS_MIN_INTERVAL_MS=250
HELIUS_CACHE_MS=2000
HELIUS_MAX_RETRIES=2
HELIUS_BACKOFF_BASE_MS=30000
HELIUS_BACKOFF_MAX_MS=900000

# V5 strategy engines
STRATEGY_POLL_MS=2000
LAUNCH_POLL_MS=10000

# Optional durable state. Recommended on Render so wallets/orders survive restarts.
DATABASE_URL=
DATABASE_SSL=false

# Manual live swaps are OFF unless explicitly enabled.
ENABLE_LIVE_TRADING=false
BS58_PRIVATE_KEY=

# SECOND opt-in for unattended live limit/DCA/TP-SL/sniper execution.
# Leave false until the equivalent strategies have been tested in PAPER mode.
ENABLE_LIVE_AUTOMATION=false
