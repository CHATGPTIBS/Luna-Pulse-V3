DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
ADMIN_USER_ID=
HELIUS_API_KEY=
JUPITER_API_KEY=

# Lightweight wallet-change preflight. Replace with a dedicated Solana RPC
# if the public endpoint is rate-limited in your deployment.
SOLANA_SIGNATURE_RPC_URL=https://api.mainnet-beta.solana.com

# Luna V3 adaptive monitoring
WALLET_SCHEDULER_MS=2000
WALLET_HOT_POLL_MS=15000
WALLET_HOT_HOLD_MS=300000
WALLET_IDLE_POLL_MS=60000
PRICE_POLL_MS=30000
HELIUS_TX_LIMIT=20

# Helius protection
HELIUS_MIN_INTERVAL_MS=250
HELIUS_CACHE_MS=2000
HELIUS_MAX_RETRIES=2
HELIUS_BACKOFF_BASE_MS=30000
HELIUS_BACKOFF_MAX_MS=900000

# Live execution remains opt-in and is not used by the V3 paper monitor.
ENABLE_LIVE_TRADING=false
BS58_PRIVATE_KEY=
